// Novadesk Helpdesk — single-tenant data model.
// Exactly one Tenant row exists: it holds this helpdesk's own branding and
// settings (logo, colours, out-of-hours, etc.), not a customer boundary.
// `tenantId` columns are retained for historical/infra reasons but every
// row shares the same one; `Company` (below) is the real "who's this
// person with" grouping, and it is purely organisational — not a security
// or data-isolation boundary.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // DATABASE_URL: the app's normal runtime connection — fine (preferred,
  // even) to point this at a pooled connection (e.g. Neon's "-pooler"
  // endpoint), since Cloud Run can run many container instances at once.
  url = env("DATABASE_URL")
  // DIRECT_URL: an *unpooled* connection, used only by `prisma migrate
  // deploy`/`migrate dev` (docker-entrypoint.sh runs this on every
  // container start). Migrations need session-level Postgres features
  // (advisory locks, prepared statements) that a PgBouncer-style pooler
  // doesn't support — pointing migrations at a pooled connection is a
  // well-known way for `migrate deploy` to hang or fail silently.
  // DIRECT_URL must actually be set wherever DATABASE_URL is (see
  // .env.example / docker-compose.yml) — docker-entrypoint.sh additionally
  // falls back to DATABASE_URL if it's missing, but that fallback doesn't
  // reach a bare `npx prisma ...` run outside that script.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Tenancy & Identity
// ---------------------------------------------------------------------------

model Tenant {
  id         String      @id @default(cuid())
  name       String
  slug       String      @unique // used for subdomain routing: {slug}.novadesk.app
  /// Google Workspace domain used to restrict SSO sign-in for this tenant (e.g. "willowbrook-primary.sch.uk")
  domain     String?     @unique
  /// DfE unique reference number for the school, if provided
  urn        String?
  phase      SchoolPhase @default(PRIMARY)
  logoUrl    String?
  brandColor String      @default("#2563eb")
  /// Overrides the "Novadesk" wordmark in the portal nav header, for schools that want to fully rebrand.
  appName    String?
  /// Portal nav sidebar background colour. Defaults to the app's standard white sidebar when unset.
  sidebarColor String?
  timezone   String      @default("Europe/London")
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  /// Staff nav modules this school has hidden (values match PortalNav's link hrefs), e.g. ["/portal/forums"].
  disabledNavItems String[] @default([])

  // Out-of-hours auto-reply (applied to new tickets created outside this window)
  outOfHoursEnabled     Boolean @default(false)
  outOfHoursStart       String  @default("17:00")
  outOfHoursEnd         String  @default("08:00")
  outOfHoursWeekendOnly Boolean @default(false)
  outOfHoursMessage     String  @default("Thanks for your ticket — our IT team is currently out of hours. We'll pick this up next school day.") @db.Text

  users                 User[]
  companies             Company[]
  brands                Brand[]
  categories            Category[]
  tickets               Ticket[]
  kbCategories          KbCategory[]
  kbArticles            KbArticle[]
  complianceAssessments ComplianceAssessment[]
  auditLogs             AuditLog[]
  aiProviderConfig      AiProviderConfig?
  portalSettings        PortalSettings?
  financeRecords        FinanceRecord[]
  forumCategories       ForumCategory[]
  forumTopics           ForumTopic[]
  assets                Asset[]
  announcements         Announcement[]
  cannedResponses       CannedResponse[]
  agentToolCommands     AgentToolCommand[]
  agentToolLinks        AgentToolLink[]
  holidays              Holiday[]
  passwordEntries       PasswordEntry[]
  agentTodos            AgentTodo[]
  notifications         Notification[]
}

enum SchoolPhase {
  NURSERY
  PRIMARY
  SECONDARY
  ALL_THROUGH
  SPECIAL
  MULTI_ACADEMY_TRUST
}

/// A client organisation (e.g. a school) whose people use this one shared
/// helpdesk. Purely an organisational label for filtering/reporting — NOT a
/// security or data-isolation boundary. Every Company belongs to the same
/// single Tenant; there is no per-Company data separation.
model Company {
  id        String       @id @default(cuid())
  tenantId  String
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  /// No longer used to gate sign-in, but reused to auto-match a brand-new
  /// inbound-email sender to this Company by their address's domain — see
  /// src/app/api/inbound-email/route.ts.
  domain    String?
  /// DfE unique reference number, if this Company is a school.
  urn       String?
  phase     SchoolPhase?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  users          User[]
  tickets        Ticket[]
  financeRecords FinanceRecord[]
  assets         Asset[]

  @@unique([tenantId, name])
}

/// A distinct trading name/business this one helpdesk answers tickets for
/// (e.g. "Education Lincs" and "Schools Online"). Unlike Company, this DOES
/// restrict what a Technician sees by default: an AGENT assigned to one or
/// more Brands only sees that Brand's tickets in their queue, so two
/// businesses can share one Novadesk install without technicians treading
/// on each other's work. Admins are never restricted — they see every
/// Brand's tickets regardless of their own Brand assignments. A Technician
/// with no Brand assignments at all also sees everything, so a
/// single-brand helpdesk (the common case) needs no configuration.
model Brand {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  /// The inbound support address for this brand (e.g. helpdesk@education-lincs.com) — used to route inbound email-to-ticket to the right brand.
  supportEmail String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tickets     Ticket[]
  technicians User[]   @relation("BrandTechnicians")

  @@unique([tenantId, name])
}

enum Role {
  SUPER_ADMIN // Novadesk platform staff, cross-tenant
  TENANT_ADMIN // School IT lead / SBM
  AGENT // Helpdesk technician
  REQUESTER // Teacher / staff member raising tickets
}

model User {
  id       String  @id @default(cuid())
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Which client organisation (e.g. school) this person belongs to, if any.
  /// Purely organisational — see Company's own doc comment.
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  /// Globally unique (not just per-tenant): Auth.js's Prisma adapter looks
  /// users up by email directly, and in practice one Google account maps to
  /// exactly one school via its Workspace domain anyway.
  email    String  @unique
  name     String?
  /// Google's OAuth profile photo URL — separate from `avatarUrl` (a
  /// deliberate self-upload), which always takes priority when set.
  image    String?
  role     Role    @default(REQUESTER)
  jobTitle String?
  phone    String?
  /// Self-uploaded profile photo, stored via src/lib/storage.ts (a storage
  /// key, not a URL) — served through /api/account/avatar. Distinct from
  /// `image` so a self-upload isn't silently replaced if Google's OAuth
  /// profile data ever gets re-synced.
  avatarUrl String?
  /// Appended to ticket replies via the "Insert signature" button — plain text, not rich HTML.
  signature String? @db.Text

  // Auth.js
  emailVerified DateTime?
  accounts      Account[]
  sessions      Session[]

  // 2FA (TOTP, required in addition to Google SSO for admins/agents)
  twoFactorEnabled       Boolean  @default(false)
  twoFactorSecret        String?
  twoFactorRecoveryCodes String[] @default([])

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// False for a User row auto-created from an inbound support email whose
  /// sender wasn't already invited — they get a ticket, not portal access.
  /// An admin invite (POST /api/admin/users) always sets this true, since
  /// that's an explicit decision to let someone in. signIn() in auth.ts
  /// checks this in addition to the row simply existing.
  portalAccessGranted Boolean @default(true)

  /// Which Brand(s) this Technician's ticket queue is scoped to (see
  /// Brand's doc comment). Irrelevant for other roles.
  technicianBrands Brand[] @relation("BrandTechnicians")

  assignedTickets               Ticket[]               @relation("AssignedTickets")
  requestedTickets              Ticket[]               @relation("RequestedTickets")
  ticketComments                TicketComment[]
  kbArticlesAuthored            KbArticle[]
  complianceAssessmentsReviewed ComplianceAssessment[]
  auditLogs                     AuditLog[]
  financeRecordsRequested       FinanceRecord[]
  forumTopicsAuthored           ForumTopic[]
  forumRepliesAuthored          ForumReply[]
  assignedAssets                Asset[]
  announcementsCreated          Announcement[]
  passwordEntriesCreated        PasswordEntry[]
  todos                         AgentTodo[]
  notifications                 Notification[]

  @@index([tenantId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Ticketing
// ---------------------------------------------------------------------------

model Category {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  color       String   @default("#64748b")
  tickets     Ticket[]

  @@unique([tenantId, name])
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  ON_HOLD
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// ITIL-style categorization, orthogonal to Category (which is more like "Printing"/"Network")
enum TicketType {
  PROBLEM
  INCIDENT
  REQUEST
  INFORMATION
  TRAINING
  QUOTE
}

model Ticket {
  id          String         @id @default(cuid())
  tenantId    String
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Sequential per-tenant ticket number shown to users, e.g. #1042
  number      Int
  subject     String
  description String         @db.Text
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  type        TicketType     @default(INCIDENT)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  /// Which business this ticket is for — see Brand's doc comment. Null for
  /// a helpdesk that hasn't set up Brands at all (the common single-brand case).
  brandId String?
  brand   Brand?  @relation(fields: [brandId], references: [id])

  /// Which school/organisation this ticket is for. Auto-filled from the
  /// requester's own Company at creation time (see createTicket in
  /// src/lib/tickets.ts) but independently editable afterward — e.g. staff
  /// raising a ticket for someone whose own profile has no Company set yet,
  /// or correcting a wrong auto-match. Reports/filtering read this field,
  /// not requester.companyId, once it's set.
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  requesterId String
  requester   User   @relation("RequestedTickets", fields: [requesterId], references: [id])

  assigneeId String?
  assignee   User?   @relation("AssignedTickets", fields: [assigneeId], references: [id])

  // AI assistance (populated by the pluggable AI provider, see src/lib/ai)
  aiSuggestedCategory String?
  aiSuggestedPriority TicketPriority?
  aiSummary           String?         @db.Text
  /// 0-100 estimate of requester frustration, from AI triage
  sentimentScore      Int?
  aiSuggestedSolution String?         @db.Text

  dueAt        DateTime?
  resolvedAt   DateTime?
  closedAt     DateTime?
  /// Set the first time an SLA-breach alert email goes out for this ticket
  /// (see src/lib/triggers.ts) — stops the scheduled check from re-sending
  /// the same alert on every run. Cleared whenever dueAt changes (priority
  /// edited or ticket reopened) so a ticket can alert again if it breaches
  /// a second time.
  slaBreachAlertedAt DateTime?
  /// True if raised while the tenant's configured out-of-hours window was active
  isOutOfHours Boolean   @default(false)
  /// Soft-deleted tickets are hidden from normal views but recoverable from the trash bin
  isDeleted    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  comments     TicketComment[]
  attachments  TicketAttachment[]
  satisfaction TicketSatisfaction?

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([tenantId, assigneeId])
  @@index([tenantId, companyId])
}

model TicketComment {
  id         String   @id @default(cuid())
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation(fields: [authorId], references: [id])
  body       String   @db.Text
  /// Internal notes are only visible to AGENT/TENANT_ADMIN/SUPER_ADMIN, never the requester
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())

  attachments TicketAttachment[]
}

model TicketAttachment {
  id          String         @id @default(cuid())
  ticketId    String
  ticket      Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  commentId   String?
  comment     TicketComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  fileName    String
  url         String
  fileSize    Int?
  contentType String?
  createdAt   DateTime       @default(now())
}

// ---------------------------------------------------------------------------
// Knowledge base
// ---------------------------------------------------------------------------

model KbCategory {
  id       String      @id @default(cuid())
  tenantId String
  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name     String
  slug     String
  articles KbArticle[]

  @@unique([tenantId, slug])
}

enum KbStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model KbArticle {
  id         String      @id @default(cuid())
  tenantId   String
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoryId String?
  category   KbCategory? @relation(fields: [categoryId], references: [id])
  title      String
  slug       String
  /// Markdown content
  content    String      @db.Text
  status     KbStatus    @default(DRAFT)
  aiSummary  String?     @db.Text
  viewCount  Int         @default(0)
  /// Soft-deleted articles are hidden from normal views but recoverable from the trash bin
  isDeleted  Boolean     @default(false)

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  attachments KbAttachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId, status])
}

model KbAttachment {
  id          String    @id @default(cuid())
  articleId   String
  article     KbArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  fileName    String
  url         String
  fileSize    Int?
  contentType String?
  createdAt   DateTime  @default(now())
}

// ---------------------------------------------------------------------------
// DfE "Digital and technology standards" compliance checklist
//
// ComplianceStandard/ComplianceItem form a global catalogue (shared across
// all tenants, seeded from prisma/seed.ts). ComplianceAssessment is the
// per-tenant record of where a school stands against each item.
// ---------------------------------------------------------------------------

model ComplianceStandard {
  id          String  @id @default(cuid())
  /// Stable slug matching the DfE standard, e.g. "cyber-security"
  code        String  @unique
  title       String
  description String  @db.Text
  officialUrl String?
  order       Int     @default(0)

  items ComplianceItem[]
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

model ComplianceItem {
  id          String             @id @default(cuid())
  standardId  String
  standard    ComplianceStandard @relation(fields: [standardId], references: [id], onDelete: Cascade)
  code        String
  title       String
  description String             @db.Text
  guidance    String?            @db.Text
  order       Int                @default(0)
  /// How much this item matters relative to others under the same standard
  priority    Priority           @default(MEDIUM)
  /// Deep link to the specific DfE guidance sub-page for this item, if more specific than the standard's officialUrl
  govLink     String?

  assessments ComplianceAssessment[]

  @@unique([standardId, code])
}

enum ComplianceStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLIANT
  NON_COMPLIANT
  NOT_APPLICABLE
}

model ComplianceAssessment {
  id       String         @id @default(cuid())
  tenantId String
  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  itemId   String
  item     ComplianceItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  status        ComplianceStatus @default(NOT_STARTED)
  evidenceNotes String?          @db.Text
  evidenceUrl   String?

  reviewedById  String?
  reviewedBy    User?     @relation(fields: [reviewedById], references: [id])
  reviewedAt    DateTime?
  nextReviewDue DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, itemId])
  @@index([tenantId, status])
}

// ---------------------------------------------------------------------------
// AI provider configuration (pluggable: Claude or Gemini, per tenant)
// ---------------------------------------------------------------------------

enum AiProvider {
  CLAUDE
  GEMINI
  DISABLED
}

model AiProviderConfig {
  id                   String     @id @default(cuid())
  tenantId             String     @unique
  tenant               Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider             AiProvider @default(DISABLED)
  model                String?
  /// Encrypted at rest by src/lib/crypto.ts before being written here
  apiKeyCiphertext     String?
  ticketTriageEnabled  Boolean    @default(true)
  kbSuggestionsEnabled Boolean    @default(true)
  updatedAt            DateTime   @updatedAt
}

// ---------------------------------------------------------------------------
// Audit log — records privileged actions for DfE cyber security / data
// protection accountability requirements.
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String?
  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
}

// ---------------------------------------------------------------------------
// Self-service portal customization (branding + content, per tenant)
// ---------------------------------------------------------------------------

model PortalSettings {
  id       String @id @default(cuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  heroTitle      String  @default("Hello, how can we help?")
  heroSubtitle   String  @default("Search our knowledge base or submit a ticket.")
  heroShowSearch Boolean @default(true)

  showAnnouncements   Boolean @default(true)
  showQuickActions    Boolean @default(true)
  showPopularArticles Boolean @default(true)
  showUrgentHelp      Boolean @default(true)
  showUsefulLinks     Boolean @default(true)

  /// { id, title, url }[]
  usefulLinks Json @default("[]")

  urgentHelpEnabled      Boolean @default(true)
  urgentHelpTitle        String  @default("Need urgent help?")
  urgentHelpDescription  String  @default("For critical issues stopping teaching right now, please call us immediately.") @db.Text
  urgentHelpHotline      String  @default("")
  urgentHelpEmail        String  @default("")
  urgentHelpAvailability String  @default("Available during school office hours")

  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Finance / procurement tracking
// ---------------------------------------------------------------------------

enum FinanceStatus {
  PENDING
  APPROVED
  ORDERED
  DELIVERED
}

model FinanceRecord {
  id          String @id @default(cuid())
  tenantId    String
  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  poNumber    String
  description String @db.Text
  /// Stored in pence to avoid floating-point rounding on currency
  amountPence Int
  vendor      String

  status FinanceStatus @default(PENDING)

  requestedById String
  requestedBy   User   @relation(fields: [requestedById], references: [id])

  /// Which school/organisation this PO is for — set directly by whoever
  /// raises it, or picked up during a bulk import; unlike Ticket there's no
  /// requester to auto-derive it from (requestedBy is the staff member who
  /// logged it, not who it's for).
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  requestDate DateTime @default(now())
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, companyId])
}

// ---------------------------------------------------------------------------
// Forums
// ---------------------------------------------------------------------------

enum ForumVisibility {
  PUBLIC // visible to requesters too
  INTERNAL // staff only
}

model ForumCategory {
  id          String          @id @default(cuid())
  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title       String
  description String?
  visibility  ForumVisibility @default(PUBLIC)
  order       Int             @default(0)

  topics ForumTopic[]

  @@unique([tenantId, title])
}

model ForumTopic {
  id         String        @id @default(cuid())
  tenantId   String
  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoryId String
  category   ForumCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  title      String
  content    String        @db.Text

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  pinned    Boolean  @default(false)
  views     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  replies ForumReply[]

  @@index([tenantId, categoryId])
}

model ForumReply {
  id      String     @id @default(cuid())
  topicId String
  topic   ForumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  content   String   @db.Text
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Assets inventory (manual register — no live device telemetry)
// ---------------------------------------------------------------------------

enum AssetStatus {
  ACTIVE
  IN_REPAIR
  RETIRED
  LOST
}

model Asset {
  id           String  @id @default(cuid())
  tenantId     String
  tenant       Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tag          String
  name         String
  model        String?
  serialNumber String?

  assignedToId String?
  assignedTo   User?   @relation(fields: [assignedToId], references: [id])

  /// Which school/organisation this asset belongs to — settable directly,
  /// or matched by name during a spreadsheet import (see
  /// src/app/api/assets/import/route.ts). Independent of assignedTo's own
  /// Company, since an asset can be centrally owned before being assigned.
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  status         AssetStatus @default(ACTIVE)
  purchaseDate   DateTime?
  warrantyExpiry DateTime?
  isDeleted      Boolean     @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, tag])
  @@index([tenantId, companyId])
}

// ---------------------------------------------------------------------------
// Announcements
// ---------------------------------------------------------------------------

enum AnnouncementType {
  INFO
  WARNING
  ALERT
}

enum AnnouncementAudience {
  ALL
  STAFF
  REQUESTERS
}

model Announcement {
  id             String               @id @default(cuid())
  tenantId       String
  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title          String
  message        String               @db.Text
  type           AnnouncementType     @default(INFO)
  targetAudience AnnouncementAudience @default(ALL)
  active         Boolean              @default(true)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([tenantId, active])
}

// ---------------------------------------------------------------------------
// Canned responses
// ---------------------------------------------------------------------------

model CannedResponse {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title    String
  shortcut String
  content  String @db.Text

  createdAt DateTime @default(now())

  @@unique([tenantId, shortcut])
}

// ---------------------------------------------------------------------------
// Agent tools — IT quick-reference commands and admin console links.
// Sensible defaults ship as app-level constants (src/lib/agent-tools.ts);
// these models are only for a tenant's own additions.
// ---------------------------------------------------------------------------

enum AgentOs {
  WINDOWS
  MAC
  CHROMEBOOK
}

model AgentToolCommand {
  id          String  @id @default(cuid())
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title       String
  command     String
  description String?
  os          AgentOs

  createdAt DateTime @default(now())
}

model AgentToolLink {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title    String
  url      String

  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Holidays — bank/school holiday dates. A ticket raised on one of these
// counts as out-of-hours regardless of time of day (see
// src/lib/out-of-hours.ts), same treatment as a weekend.
// ---------------------------------------------------------------------------

model Holiday {
  id       String   @id @default(cuid())
  tenantId String
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  date     DateTime @db.Date
  name     String

  createdAt DateTime @default(now())

  @@unique([tenantId, date])
}

// ---------------------------------------------------------------------------
// Password vault — shared credentials for the IT team (admin consoles,
// vendor logins, etc.), not customer-facing. Staff-only (AGENT/TENANT_ADMIN/
// SUPER_ADMIN), same access level as Agent tools' console links, which this
// is the natural extension of. The password itself is AES-256-GCM encrypted
// at rest via src/lib/crypto.ts (same helper already used for TOTP secrets
// and AI provider API keys) — never stored or returned in plaintext except
// to an authenticated staff member explicitly asking to reveal one entry.
// ---------------------------------------------------------------------------

model PasswordEntry {
  id                String   @id @default(cuid())
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title             String
  username          String?
  encryptedPassword String
  url               String?
  notes             String?  @db.Text

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Agent to-dos — a personal task list per technician/admin. Deliberately
// not shared/assignable to others; that's what ticket assignment is for.
// ---------------------------------------------------------------------------

model AgentTodo {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  text     String
  isDone   Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Customer satisfaction — one optional rating per ticket, left by the
// requester once it's resolved/closed. Not solicited by a separate email
// survey flow; the prompt lives directly on the ticket page.
// ---------------------------------------------------------------------------

model TicketSatisfaction {
  id       String @id @default(cuid())
  ticketId String @unique
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  /// 1 (very unhappy) to 5 (very happy)
  rating   Int
  comment  String? @db.Text

  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// In-app notifications — the bell-icon inbox in the portal nav. Deliberately
// separate from the email NotificationProvider in src/lib/notifications: the
// same ticket events (created/commented/assigned/resolved/SLA breach) fan
// out to both, but this is what actually renders in-app.
// ---------------------------------------------------------------------------

model Notification {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// e.g. "ticket.created" | "ticket.comment" | "ticket.assigned" | "ticket.resolved" | "sla.breach"
  type   String
  title  String
  body   String?
  /// In-app path to navigate to on click, e.g. "/portal/tickets/abc123"
  link   String?
  isRead Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([tenantId])
}
