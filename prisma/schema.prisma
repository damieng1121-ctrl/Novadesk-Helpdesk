// Novadesk Helpdesk — multi-tenant data model
// Tenant = one school. Every tenant-scoped model carries a `tenantId` and
// MUST be queried through the helpers in `src/lib/tenancy.ts` so tenant
// isolation can't be bypassed by an accidental unscoped query.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenancy & Identity
// ---------------------------------------------------------------------------

model Tenant {
  id         String      @id @default(cuid())
  name       String
  slug       String      @unique // used for subdomain routing: {slug}.novadesk.app
  /// Google Workspace domain used to restrict SSO sign-in for this tenant (e.g. "willowbrook-primary.sch.uk")
  domain     String?     @unique
  /// DfE unique reference number for the school, if provided
  urn        String?
  phase      SchoolPhase @default(PRIMARY)
  logoUrl    String?
  brandColor String      @default("#2563eb")
  /// Overrides the "Novadesk" wordmark in the portal nav header, for schools that want to fully rebrand.
  appName    String?
  /// Portal nav sidebar background colour. Defaults to the app's standard white sidebar when unset.
  sidebarColor String?
  timezone   String      @default("Europe/London")
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  /// Staff nav modules this school has hidden (values match PortalNav's link hrefs), e.g. ["/portal/forums"].
  disabledNavItems String[] @default([])

  // Out-of-hours auto-reply (applied to new tickets created outside this window)
  outOfHoursEnabled     Boolean @default(false)
  outOfHoursStart       String  @default("17:00")
  outOfHoursEnd         String  @default("08:00")
  outOfHoursWeekendOnly Boolean @default(false)
  outOfHoursMessage     String  @default("Thanks for your ticket — our IT team is currently out of hours. We'll pick this up next school day.") @db.Text

  users                 User[]
  categories            Category[]
  tickets               Ticket[]
  kbCategories          KbCategory[]
  kbArticles            KbArticle[]
  complianceAssessments ComplianceAssessment[]
  auditLogs             AuditLog[]
  aiProviderConfig      AiProviderConfig?
  portalSettings        PortalSettings?
  financeRecords        FinanceRecord[]
  forumCategories       ForumCategory[]
  forumTopics           ForumTopic[]
  assets                Asset[]
  announcements         Announcement[]
  cannedResponses       CannedResponse[]
  agentToolCommands     AgentToolCommand[]
  agentToolLinks        AgentToolLink[]

  // --- School MIS additions ---
  academicYears            AcademicYear[]
  formGroups               FormGroup[]
  pupils                   Pupil[]
  pupilGuardians           PupilGuardian[]
  attendanceRecords        AttendanceRecord[]
  behaviourIncidents       BehaviourIncident[]
  accidentReports          AccidentReport[]
  sendPlans                SendPlan[]
  assessmentSubjects       AssessmentSubject[]
  assessmentResults        AssessmentResult[]
  pupilTargets             PupilTarget[]
  mealRecords              MealRecord[]
  clubs                    Club[]
  clubMemberships          ClubMembership[]
  staffProfiles            StaffProfile[]
  interventions            Intervention[]
  interventionNotes        InterventionNote[]
  parentsEveningEvents     ParentsEveningEvent[]
  appointmentSlots         AppointmentSlot[]
  parentMessages           ParentMessage[]
  parentMessageRecipients  ParentMessageRecipient[]
}

enum SchoolPhase {
  NURSERY
  PRIMARY
  SECONDARY
  ALL_THROUGH
  SPECIAL
  MULTI_ACADEMY_TRUST
}

enum Role {
  SUPER_ADMIN // Novadesk platform staff, cross-tenant
  TENANT_ADMIN // School IT lead / SBM
  AGENT // Helpdesk technician
  REQUESTER // Teacher / staff member raising tickets
  PARENT // Guardian, signed in via email+password to the separate /parent portal
}

model User {
  id       String  @id @default(cuid())
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Globally unique (not just per-tenant): Auth.js's Prisma adapter looks
  /// users up by email directly, and in practice one Google account maps to
  /// exactly one school via its Workspace domain anyway.
  email    String  @unique
  name     String?
  image    String?
  role     Role    @default(REQUESTER)
  jobTitle String?

  // Auth.js
  emailVerified DateTime?
  accounts      Account[]
  sessions      Session[]

  // 2FA (TOTP, required in addition to Google SSO for admins/agents)
  twoFactorEnabled       Boolean  @default(false)
  twoFactorSecret        String?
  twoFactorRecoveryCodes String[] @default([])

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // --- School MIS additions ---
  /// Grants MIS classroom access (register-taking, behaviour, assessment, etc.) regardless of Role — a REQUESTER or AGENT can also be a class teacher.
  isTeacher          Boolean @default(false)
  /// Gates visibility of confidential (SAFEGUARDING/BULLYING) behaviour incidents, in addition to TENANT_ADMIN/SUPER_ADMIN.
  isSafeguardingLead Boolean @default(false)
  /// Only ever set for role=PARENT — staff always sign in via Google SSO.
  passwordHash       String?
  /// SMS-ready contact number; no SMS provider is wired up yet.
  phone              String?

  assignedTickets               Ticket[]               @relation("AssignedTickets")
  requestedTickets              Ticket[]               @relation("RequestedTickets")
  ticketComments                TicketComment[]
  kbArticlesAuthored            KbArticle[]
  complianceAssessmentsReviewed ComplianceAssessment[]
  auditLogs                     AuditLog[]
  financeRecordsRequested       FinanceRecord[]
  forumTopicsAuthored           ForumTopic[]
  forumRepliesAuthored          ForumReply[]
  assignedAssets                Asset[]
  announcementsCreated          Announcement[]

  formGroupsLed               FormGroup[]               @relation("FormGroupStaffLead")
  guardianOf                  PupilGuardian[]           @relation("GuardianLinks")
  attendanceRecordsRecorded   AttendanceRecord[]        @relation("AttendanceRecordedBy")
  behaviourIncidentsRecorded  BehaviourIncident[]       @relation("BehaviourRecordedBy")
  accidentReportsReported     AccidentReport[]          @relation("AccidentReportedBy")
  accidentReportsFirstAid     AccidentReport[]          @relation("AccidentFirstAidBy")
  sendPlansCreated             SendPlan[]                @relation("SendPlanCreatedBy")
  assessmentResultsRecorded   AssessmentResult[]        @relation("AssessmentTeacher")
  pupilTargetsCreated          PupilTarget[]             @relation("PupilTargetCreatedBy")
  mealRecordsRecorded          MealRecord[]              @relation("MealRecordedBy")
  clubsLed                     Club[]                    @relation("ClubStaffLead")
  staffProfile                  StaffProfile?
  interventionsProvided        Intervention[]            @relation("InterventionProvider")
  interventionNotesAuthored    InterventionNote[]        @relation("InterventionNoteAuthor")
  parentsEveningEventsCreated  ParentsEveningEvent[]      @relation("ParentsEveningCreatedBy")
  appointmentSlotsAsTeacher    AppointmentSlot[]          @relation("AppointmentTeacher")
  appointmentSlotsAsGuardian   AppointmentSlot[]          @relation("AppointmentGuardian")
  parentMessagesSent           ParentMessage[]            @relation("ParentMessageSender")
  parentMessageRecipientOf     ParentMessageRecipient[]   @relation("ParentMessageRecipientGuardian")

  @@index([tenantId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Ticketing
// ---------------------------------------------------------------------------

model Category {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  color       String   @default("#64748b")
  tickets     Ticket[]

  @@unique([tenantId, name])
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  ON_HOLD
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// ITIL-style categorization, orthogonal to Category (which is more like "Printing"/"Network")
enum TicketType {
  PROBLEM
  INCIDENT
  REQUEST
  INFORMATION
  TRAINING
  QUOTE
}

model Ticket {
  id          String         @id @default(cuid())
  tenantId    String
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Sequential per-tenant ticket number shown to users, e.g. #1042
  number      Int
  subject     String
  description String         @db.Text
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  type        TicketType     @default(INCIDENT)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  requesterId String
  requester   User   @relation("RequestedTickets", fields: [requesterId], references: [id])

  assigneeId String?
  assignee   User?   @relation("AssignedTickets", fields: [assigneeId], references: [id])

  // AI assistance (populated by the pluggable AI provider, see src/lib/ai)
  aiSuggestedCategory String?
  aiSuggestedPriority TicketPriority?
  aiSummary           String?         @db.Text
  /// 0-100 estimate of requester frustration, from AI triage
  sentimentScore      Int?
  aiSuggestedSolution String?         @db.Text

  dueAt        DateTime?
  resolvedAt   DateTime?
  closedAt     DateTime?
  /// True if raised while the tenant's configured out-of-hours window was active
  isOutOfHours Boolean   @default(false)
  /// Soft-deleted tickets are hidden from normal views but recoverable from the trash bin
  isDeleted    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  comments    TicketComment[]
  attachments TicketAttachment[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([tenantId, assigneeId])
}

model TicketComment {
  id         String   @id @default(cuid())
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation(fields: [authorId], references: [id])
  body       String   @db.Text
  /// Internal notes are only visible to AGENT/TENANT_ADMIN/SUPER_ADMIN, never the requester
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())

  attachments TicketAttachment[]
}

model TicketAttachment {
  id          String         @id @default(cuid())
  ticketId    String
  ticket      Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  commentId   String?
  comment     TicketComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  fileName    String
  url         String
  fileSize    Int?
  contentType String?
  createdAt   DateTime       @default(now())
}

// ---------------------------------------------------------------------------
// Knowledge base
// ---------------------------------------------------------------------------

model KbCategory {
  id       String      @id @default(cuid())
  tenantId String
  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name     String
  slug     String
  articles KbArticle[]

  @@unique([tenantId, slug])
}

enum KbStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model KbArticle {
  id         String      @id @default(cuid())
  tenantId   String
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoryId String?
  category   KbCategory? @relation(fields: [categoryId], references: [id])
  title      String
  slug       String
  /// Markdown content
  content    String      @db.Text
  status     KbStatus    @default(DRAFT)
  aiSummary  String?     @db.Text
  viewCount  Int         @default(0)
  /// Soft-deleted articles are hidden from normal views but recoverable from the trash bin
  isDeleted  Boolean     @default(false)

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId, status])
}

// ---------------------------------------------------------------------------
// DfE "Digital and technology standards" compliance checklist
//
// ComplianceStandard/ComplianceItem form a global catalogue (shared across
// all tenants, seeded from prisma/seed.ts). ComplianceAssessment is the
// per-tenant record of where a school stands against each item.
// ---------------------------------------------------------------------------

model ComplianceStandard {
  id          String  @id @default(cuid())
  /// Stable slug matching the DfE standard, e.g. "cyber-security"
  code        String  @unique
  title       String
  description String  @db.Text
  officialUrl String?
  order       Int     @default(0)

  items ComplianceItem[]
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

model ComplianceItem {
  id          String             @id @default(cuid())
  standardId  String
  standard    ComplianceStandard @relation(fields: [standardId], references: [id], onDelete: Cascade)
  code        String
  title       String
  description String             @db.Text
  guidance    String?            @db.Text
  order       Int                @default(0)
  /// How much this item matters relative to others under the same standard
  priority    Priority           @default(MEDIUM)
  /// Deep link to the specific DfE guidance sub-page for this item, if more specific than the standard's officialUrl
  govLink     String?

  assessments ComplianceAssessment[]

  @@unique([standardId, code])
}

enum ComplianceStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLIANT
  NON_COMPLIANT
  NOT_APPLICABLE
}

model ComplianceAssessment {
  id       String         @id @default(cuid())
  tenantId String
  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  itemId   String
  item     ComplianceItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  status        ComplianceStatus @default(NOT_STARTED)
  evidenceNotes String?          @db.Text
  evidenceUrl   String?

  reviewedById  String?
  reviewedBy    User?     @relation(fields: [reviewedById], references: [id])
  reviewedAt    DateTime?
  nextReviewDue DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, itemId])
  @@index([tenantId, status])
}

// ---------------------------------------------------------------------------
// AI provider configuration (pluggable: Claude or Gemini, per tenant)
// ---------------------------------------------------------------------------

enum AiProvider {
  CLAUDE
  GEMINI
  DISABLED
}

model AiProviderConfig {
  id                   String     @id @default(cuid())
  tenantId             String     @unique
  tenant               Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider             AiProvider @default(DISABLED)
  model                String?
  /// Encrypted at rest by src/lib/crypto.ts before being written here
  apiKeyCiphertext     String?
  ticketTriageEnabled  Boolean    @default(true)
  kbSuggestionsEnabled Boolean    @default(true)
  updatedAt            DateTime   @updatedAt
}

// ---------------------------------------------------------------------------
// Audit log — records privileged actions for DfE cyber security / data
// protection accountability requirements.
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String?
  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
}

// ---------------------------------------------------------------------------
// Self-service portal customization (branding + content, per tenant)
// ---------------------------------------------------------------------------

model PortalSettings {
  id       String @id @default(cuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  heroTitle      String  @default("Hello, how can we help?")
  heroSubtitle   String  @default("Search our knowledge base or submit a ticket.")
  heroShowSearch Boolean @default(true)

  showAnnouncements   Boolean @default(true)
  showQuickActions    Boolean @default(true)
  showPopularArticles Boolean @default(true)
  showUrgentHelp      Boolean @default(true)
  showUsefulLinks     Boolean @default(true)

  /// { id, title, url }[]
  usefulLinks Json @default("[]")

  urgentHelpEnabled      Boolean @default(true)
  urgentHelpTitle        String  @default("Need urgent help?")
  urgentHelpDescription  String  @default("For critical issues stopping teaching right now, please call us immediately.") @db.Text
  urgentHelpHotline      String  @default("")
  urgentHelpEmail        String  @default("")
  urgentHelpAvailability String  @default("Available during school office hours")

  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Finance / procurement tracking
// ---------------------------------------------------------------------------

enum FinanceStatus {
  PENDING
  APPROVED
  ORDERED
  DELIVERED
}

model FinanceRecord {
  id          String @id @default(cuid())
  tenantId    String
  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  poNumber    String
  description String @db.Text
  /// Stored in pence to avoid floating-point rounding on currency
  amountPence Int
  vendor      String

  status FinanceStatus @default(PENDING)

  requestedById String
  requestedBy   User   @relation(fields: [requestedById], references: [id])

  requestDate DateTime @default(now())
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, status])
}

// ---------------------------------------------------------------------------
// Forums
// ---------------------------------------------------------------------------

enum ForumVisibility {
  PUBLIC // visible to requesters too
  INTERNAL // staff only
}

model ForumCategory {
  id          String          @id @default(cuid())
  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title       String
  description String?
  visibility  ForumVisibility @default(PUBLIC)
  order       Int             @default(0)

  topics ForumTopic[]

  @@unique([tenantId, title])
}

model ForumTopic {
  id         String        @id @default(cuid())
  tenantId   String
  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoryId String
  category   ForumCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  title      String
  content    String        @db.Text

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  pinned    Boolean  @default(false)
  views     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  replies ForumReply[]

  @@index([tenantId, categoryId])
}

model ForumReply {
  id      String     @id @default(cuid())
  topicId String
  topic   ForumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  content   String   @db.Text
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Assets inventory (manual register — no live device telemetry)
// ---------------------------------------------------------------------------

enum AssetStatus {
  ACTIVE
  IN_REPAIR
  RETIRED
  LOST
}

model Asset {
  id           String  @id @default(cuid())
  tenantId     String
  tenant       Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tag          String
  name         String
  model        String?
  serialNumber String?

  assignedToId String?
  assignedTo   User?   @relation(fields: [assignedToId], references: [id])

  status         AssetStatus @default(ACTIVE)
  purchaseDate   DateTime?
  warrantyExpiry DateTime?
  isDeleted      Boolean     @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, tag])
}

// ---------------------------------------------------------------------------
// Announcements
// ---------------------------------------------------------------------------

enum AnnouncementType {
  INFO
  WARNING
  ALERT
}

enum AnnouncementAudience {
  ALL
  STAFF
  REQUESTERS
}

model Announcement {
  id             String               @id @default(cuid())
  tenantId       String
  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title          String
  message        String               @db.Text
  type           AnnouncementType     @default(INFO)
  targetAudience AnnouncementAudience @default(ALL)
  active         Boolean              @default(true)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([tenantId, active])
}

// ---------------------------------------------------------------------------
// Canned responses
// ---------------------------------------------------------------------------

model CannedResponse {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title    String
  shortcut String
  content  String @db.Text

  createdAt DateTime @default(now())

  @@unique([tenantId, shortcut])
}

// ---------------------------------------------------------------------------
// Agent tools — IT quick-reference commands and admin console links.
// Sensible defaults ship as app-level constants (src/lib/agent-tools.ts);
// these models are only for a tenant's own additions.
// ---------------------------------------------------------------------------

enum AgentOs {
  WINDOWS
  MAC
  CHROMEBOOK
}

model AgentToolCommand {
  id          String  @id @default(cuid())
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title       String
  command     String
  description String?
  os          AgentOs

  createdAt DateTime @default(now())
}

model AgentToolLink {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title    String
  url      String

  createdAt DateTime @default(now())
}

// =============================================================================
// School MIS
//
// Adds pupils, attendance, behaviour & welfare (incl. SEND), assessment,
// school operations (meals/clubs/staff/interventions), parents' evenings,
// and parent communication on top of the helpdesk's existing tenancy/auth.
// Same rule as everything above: every model here carries `tenantId` and
// MUST be queried scoped to `session.user.tenantId` — never trust a
// client-supplied id alone.
// =============================================================================

enum YearGroup {
  NURSERY
  RECEPTION
  YEAR_1
  YEAR_2
  YEAR_3
  YEAR_4
  YEAR_5
  YEAR_6
  YEAR_7
  YEAR_8
  YEAR_9
  YEAR_10
  YEAR_11
  YEAR_12
  YEAR_13
}

enum Gender {
  MALE
  FEMALE
}

enum SendStatus {
  NONE
  SEND_SUPPORT
  EHCP
}

enum SendPrimaryNeed {
  COMMUNICATION
  COGNITION
  SEMH
  SENSORY_PHYSICAL
}

enum PupilGuardianRelationship {
  MOTHER
  FATHER
  GUARDIAN
  GRANDPARENT
  CARER
  OTHER
}

model AcademicYear {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String // e.g. "2025/2026"
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)

  formGroups        FormGroup[]
  assessmentResults AssessmentResult[]
  clubs             Club[]

  @@unique([tenantId, name])
}

model FormGroup {
  id             String       @id @default(cuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  name           String // e.g. "3W"
  yearGroup      YearGroup

  staffLeadId String?
  staffLead   User?   @relation("FormGroupStaffLead", fields: [staffLeadId], references: [id])

  pupils Pupil[]

  @@unique([tenantId, academicYearId, name])
}

model Pupil {
  id              String     @id @default(cuid())
  tenantId        String
  tenant          Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// DfE Unique Pupil Number, if allocated yet
  upn             String?
  admissionNumber String?
  firstName       String
  lastName        String
  preferredName   String?
  dob             DateTime
  gender          Gender
  formGroupId     String?
  formGroup       FormGroup? @relation(fields: [formGroupId], references: [id])
  yearGroup       YearGroup

  ethnicity    String?
  homeLanguage String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  postcode     String?

  sendStatus     SendStatus @default(NONE)
  pupilPremium   Boolean    @default(false)
  freeSchoolMeals Boolean   @default(false)

  admissionDate DateTime?
  leavingDate   DateTime?
  medicalNotes  String?   @db.Text
  photoUrl      String?
  isActive      Boolean   @default(true)
  /// Soft-deleted pupils are hidden from normal views but recoverable from the trash bin
  isDeleted     Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guardians          PupilGuardian[]
  attendanceRecords  AttendanceRecord[]
  behaviourIncidents BehaviourIncident[]
  accidentReports    AccidentReport[]
  sendPlans          SendPlan[]
  assessmentResults  AssessmentResult[]
  targets            PupilTarget[]
  mealRecords        MealRecord[]
  clubMemberships    ClubMembership[]
  interventions      Intervention[]
  appointmentSlots   AppointmentSlot[]

  @@unique([tenantId, upn])
  @@index([tenantId, formGroupId])
  @@index([tenantId, isActive])
}

model PupilGuardian {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pupilId  String
  pupil    Pupil  @relation(fields: [pupilId], references: [id], onDelete: Cascade)
  /// A User with role=PARENT
  guardianId String
  guardian   User   @relation("GuardianLinks", fields: [guardianId], references: [id], onDelete: Cascade)

  relationship          PupilGuardianRelationship @default(OTHER)
  parentalResponsibility Boolean                  @default(true)
  isPrimaryContact       Boolean                  @default(false)
  isEmergencyContact     Boolean                  @default(true)
  canCollect             Boolean                  @default(true)
  priorityOrder          Int                      @default(0)

  createdAt DateTime @default(now())

  @@unique([pupilId, guardianId])
  @@index([tenantId, guardianId])
}

// ---------------------------------------------------------------------------
// Attendance
// ---------------------------------------------------------------------------

enum AttendanceSession {
  AM
  PM
}

enum AttendanceMark {
  PRESENT
  LATE
  AUTHORISED_ABSENCE
  UNAUTHORISED_ABSENCE
  APPROVED_ACTIVITY
  NOT_RECORDED
}

model AttendanceRecord {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pupilId  String
  pupil    Pupil  @relation(fields: [pupilId], references: [id], onDelete: Cascade)

  date    DateTime
  session AttendanceSession
  mark    AttendanceMark    @default(NOT_RECORDED)
  /// DfE attendance mark letter (see src/lib/attendance-codes.ts), e.g. "/", "L", "N"
  statutoryCode String
  minutesLate   Int?
  notes         String? @db.Text

  recordedById String
  recordedBy   User   @relation("AttendanceRecordedBy", fields: [recordedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, pupilId, date, session])
  @@index([tenantId, date])
}

// ---------------------------------------------------------------------------
// Behaviour & welfare
// ---------------------------------------------------------------------------

enum BehaviourCategory {
  ACHIEVEMENT
  CONCERN
  BULLYING
  SAFEGUARDING
}

model BehaviourIncident {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pupilId  String
  pupil    Pupil  @relation(fields: [pupilId], references: [id], onDelete: Cascade)

  date        DateTime
  category    BehaviourCategory
  points      Int               @default(0)
  description String            @db.Text
  location    String?
  actionTaken String?           @db.Text

  followUpRequired Boolean @default(false)
  followUpNotes    String? @db.Text
  /// Auto-true for SAFEGUARDING/BULLYING — only visible to TENANT_ADMIN/SUPER_ADMIN/isSafeguardingLead staff
  isConfidential   Boolean @default(false)

  recordedById String
  recordedBy   User   @relation("BehaviourRecordedBy", fields: [recordedById], references: [id])

  createdAt DateTime @default(now())

  @@index([tenantId, pupilId])
  @@index([tenantId, date])
}

enum AccidentSeverity {
  MINOR
  MODERATE
  SERIOUS
}

model AccidentReport {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pupilId  String
  pupil    Pupil  @relation(fields: [pupilId], references: [id], onDelete: Cascade)

  date        DateTime
  time        String
  location    String
  description String  @db.Text
  injuryType  String?
  actionTaken String  @db.Text
  severity    AccidentSeverity @default(MINOR)

  parentNotified   Boolean   @default(false)
  parentNotifiedAt DateTime?

  reportedById String
  reportedBy   User   @relation("AccidentReportedBy", fields: [reportedById], references: [id])

  firstAidGivenById String?
  firstAidGivenBy   User?   @relation("AccidentFirstAidBy", fields: [firstAidGivenById], references: [id])

  createdAt DateTime @default(now())

  @@index([tenantId, pupilId])
}

model SendPlan {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pupilId  String
  pupil    Pupil  @relation(fields: [pupilId], references: [id], onDelete: Cascade)

  status      SendStatus
  primaryNeed SendPrimaryNeed?
  description String           @db.Text
  /// Array of { target: string, progress: string, reviewDate: string }
  targets     Json             @default("[]")
  externalAgencies String?     @db.Text
  reviewDate  DateTime?

  createdById String
  createdBy   User   @relation("SendPlanCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, pupilId])
}

// ---------------------------------------------------------------------------
// Assessment
// ---------------------------------------------------------------------------

model AssessmentSubject {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name     String
  order    Int    @default(0)

  results AssessmentResult[]
  targets PupilTarget[]

  @@unique([tenantId, name])
}

model AssessmentResult {
  id             String            @id @default(cuid())
  tenantId       String
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pupilId        String
  pupil          Pupil             @relation(fields: [pupilId], references: [id], onDelete: Cascade)
  subjectId      String
  subject        AssessmentSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear      @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  term       String // e.g. "Autumn 1"
  /// School-customizable attainment band label (e.g. "Working Towards", "Expected", "Greater Depth", or a numeric score as a string)
  attainment String
  effort     String?
  notes      String? @db.Text

  teacherId String
  teacher   User   @relation("AssessmentTeacher", fields: [teacherId], references: [id])

  date DateTime @default(now())

  @@index([tenantId, pupilId])
  @@index([tenantId, subjectId])
}

enum TargetStatus {
  NOT_STARTED
  IN_PROGRESS
  ACHIEVED
}

model PupilTarget {
  id          String             @id @default(cuid())
  tenantId    String
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pupilId     String
  pupil       Pupil              @relation(fields: [pupilId], references: [id], onDelete: Cascade)
  subjectId   String?
  subject     AssessmentSubject? @relation(fields: [subjectId], references: [id])

  title       String
  description String?      @db.Text
  targetDate  DateTime?
  status      TargetStatus @default(NOT_STARTED)

  createdById String
  createdBy   User   @relation("PupilTargetCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, pupilId])
}

// ---------------------------------------------------------------------------
// School operations: meals, clubs, staff records, interventions
// ---------------------------------------------------------------------------

enum MealType {
  SCHOOL_MEAL
  PACKED_LUNCH
  HOME
  FSM
}

model MealRecord {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pupilId  String
  pupil    Pupil  @relation(fields: [pupilId], references: [id], onDelete: Cascade)

  date     DateTime
  mealType MealType

  recordedById String
  recordedBy   User   @relation("MealRecordedBy", fields: [recordedById], references: [id])

  createdAt DateTime @default(now())

  @@unique([tenantId, pupilId, date])
}

model Club {
  id             String       @id @default(cuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  name        String
  description String? @db.Text
  /// 0 = Sunday .. 6 = Saturday
  dayOfWeek   Int
  startTime   String
  endTime     String
  capacity    Int?

  staffLeadId String?
  staffLead   User?   @relation("ClubStaffLead", fields: [staffLeadId], references: [id])

  memberships ClubMembership[]
  createdAt   DateTime         @default(now())

  @@index([tenantId])
}

enum ClubMembershipStatus {
  ACTIVE
  WAITLIST
}

model ClubMembership {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clubId   String
  club     Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)
  pupilId  String
  pupil    Pupil  @relation(fields: [pupilId], references: [id], onDelete: Cascade)

  status   ClubMembershipStatus @default(ACTIVE)
  joinedAt DateTime             @default(now())

  @@unique([clubId, pupilId])
}

enum StaffType {
  TEACHING
  TEACHING_ASSISTANT
  ADMIN
  SITE
  MIDDAY
  SENCO
  OTHER
}

model StaffProfile {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId   String @unique
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  staffType                StaffType
  dbsCheckDate             DateTime?
  dbsNumber                String?
  contractType             String?
  startDate                DateTime?
  endDate                  DateTime?
  safeguardingTrainingDate DateTime?

  updatedAt DateTime @updatedAt
}

enum InterventionStatus {
  PLANNED
  ACTIVE
  COMPLETED
}

model Intervention {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pupilId  String
  pupil    Pupil  @relation(fields: [pupilId], references: [id], onDelete: Cascade)

  title         String
  subjectArea   String?
  providerId    String
  provider      User   @relation("InterventionProvider", fields: [providerId], references: [id])
  groupSize     Int?
  startDate     DateTime
  endDate       DateTime?
  targetOutcome String    @db.Text
  status        InterventionStatus @default(PLANNED)

  notes     InterventionNote[]
  createdAt DateTime           @default(now())

  @@index([tenantId, pupilId])
}

model InterventionNote {
  id             String       @id @default(cuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  interventionId String
  intervention   Intervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation("InterventionNoteAuthor", fields: [authorId], references: [id])
  note     String @db.Text

  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Parents' evenings
// ---------------------------------------------------------------------------

model ParentsEveningEvent {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  title       String
  date        DateTime
  startTime   String
  endTime     String
  slotMinutes Int      @default(10)
  /// Array of FormGroup ids this event applies to
  formGroupIds Json    @default("[]")

  bookingOpensAt  DateTime?
  bookingClosesAt DateTime?
  locationNote    String?

  createdById String
  createdBy   User   @relation("ParentsEveningCreatedBy", fields: [createdById], references: [id])

  slots     AppointmentSlot[]
  createdAt DateTime          @default(now())

  @@index([tenantId, date])
}

enum AppointmentStatus {
  AVAILABLE
  BOOKED
  CANCELLED
}

model AppointmentSlot {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  eventId  String
  event    ParentsEveningEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  teacherId String
  teacher   User   @relation("AppointmentTeacher", fields: [teacherId], references: [id])

  pupilId String?
  pupil   Pupil?  @relation(fields: [pupilId], references: [id])

  guardianId String?
  guardian   User?   @relation("AppointmentGuardian", fields: [guardianId], references: [id])

  startTime DateTime
  endTime   DateTime
  status    AppointmentStatus @default(AVAILABLE)
  notes     String?

  @@index([tenantId, eventId])
  @@index([tenantId, teacherId])
}

// ---------------------------------------------------------------------------
// Parent communication
// ---------------------------------------------------------------------------

enum MessageAudience {
  ALL_PARENTS
  YEAR_GROUP
  FORM_GROUP
  INDIVIDUAL
}

model ParentMessage {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation("ParentMessageSender", fields: [senderId], references: [id])

  subject  String
  body     String           @db.Text
  audience MessageAudience
  /// Depending on `audience`: a YearGroup value, a FormGroup id, or a Pupil id. Null for ALL_PARENTS.
  audienceRef String?

  sentAt DateTime @default(now())

  recipients ParentMessageRecipient[]

  @@index([tenantId, sentAt])
}

model ParentMessageRecipient {
  id        String        @id @default(cuid())
  tenantId  String
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messageId String
  message   ParentMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  guardianId String
  guardian   User   @relation("ParentMessageRecipientGuardian", fields: [guardianId], references: [id])
  readAt     DateTime?

  @@unique([messageId, guardianId])
  @@index([tenantId, guardianId])
}
