// Novadesk Helpdesk — multi-tenant data model
// Tenant = one school. Every tenant-scoped model carries a `tenantId` and
// MUST be queried through the helpers in `src/lib/tenancy.ts` so tenant
// isolation can't be bypassed by an accidental unscoped query.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenancy & Identity
// ---------------------------------------------------------------------------

model Tenant {
  id         String      @id @default(cuid())
  name       String
  slug       String      @unique // used for subdomain routing: {slug}.novadesk.app
  /// Google Workspace domain used to restrict SSO sign-in for this tenant (e.g. "willowbrook-primary.sch.uk")
  domain     String?     @unique
  /// DfE unique reference number for the school, if provided
  urn        String?
  phase      SchoolPhase @default(PRIMARY)
  logoUrl    String?
  brandColor String      @default("#2563eb")
  timezone   String      @default("Europe/London")
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  // Out-of-hours auto-reply (applied to new tickets created outside this window)
  outOfHoursEnabled     Boolean @default(false)
  outOfHoursStart       String  @default("17:00")
  outOfHoursEnd         String  @default("08:00")
  outOfHoursWeekendOnly Boolean @default(false)
  outOfHoursMessage     String  @default("Thanks for your ticket — our IT team is currently out of hours. We'll pick this up next school day.") @db.Text

  users                 User[]
  categories            Category[]
  tickets               Ticket[]
  kbCategories          KbCategory[]
  kbArticles            KbArticle[]
  complianceAssessments ComplianceAssessment[]
  auditLogs             AuditLog[]
  aiProviderConfig      AiProviderConfig?
  portalSettings        PortalSettings?
  financeRecords        FinanceRecord[]
  forumCategories       ForumCategory[]
  forumTopics           ForumTopic[]
  assets                Asset[]
  announcements         Announcement[]
  cannedResponses       CannedResponse[]
  agentToolCommands     AgentToolCommand[]
  agentToolLinks        AgentToolLink[]
}

enum SchoolPhase {
  NURSERY
  PRIMARY
  SECONDARY
  ALL_THROUGH
  SPECIAL
  MULTI_ACADEMY_TRUST
}

enum Role {
  SUPER_ADMIN // Novadesk platform staff, cross-tenant
  TENANT_ADMIN // School IT lead / SBM
  AGENT // Helpdesk technician
  REQUESTER // Teacher / staff member raising tickets
}

model User {
  id       String  @id @default(cuid())
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Globally unique (not just per-tenant): Auth.js's Prisma adapter looks
  /// users up by email directly, and in practice one Google account maps to
  /// exactly one school via its Workspace domain anyway.
  email    String  @unique
  name     String?
  image    String?
  role     Role    @default(REQUESTER)
  jobTitle String?

  // Auth.js
  emailVerified DateTime?
  accounts      Account[]
  sessions      Session[]

  // 2FA (TOTP, required in addition to Google SSO for admins/agents)
  twoFactorEnabled       Boolean  @default(false)
  twoFactorSecret        String?
  twoFactorRecoveryCodes String[] @default([])

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedTickets               Ticket[]               @relation("AssignedTickets")
  requestedTickets              Ticket[]               @relation("RequestedTickets")
  ticketComments                TicketComment[]
  kbArticlesAuthored            KbArticle[]
  complianceAssessmentsReviewed ComplianceAssessment[]
  auditLogs                     AuditLog[]
  financeRecordsRequested       FinanceRecord[]
  forumTopicsAuthored           ForumTopic[]
  forumRepliesAuthored          ForumReply[]
  assignedAssets                Asset[]
  announcementsCreated          Announcement[]

  @@index([tenantId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Ticketing
// ---------------------------------------------------------------------------

model Category {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  color       String   @default("#64748b")
  tickets     Ticket[]

  @@unique([tenantId, name])
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  ON_HOLD
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// ITIL-style categorization, orthogonal to Category (which is more like "Printing"/"Network")
enum TicketType {
  PROBLEM
  INCIDENT
  REQUEST
  INFORMATION
  TRAINING
  QUOTE
}

model Ticket {
  id          String         @id @default(cuid())
  tenantId    String
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Sequential per-tenant ticket number shown to users, e.g. #1042
  number      Int
  subject     String
  description String         @db.Text
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  type        TicketType     @default(INCIDENT)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  requesterId String
  requester   User   @relation("RequestedTickets", fields: [requesterId], references: [id])

  assigneeId String?
  assignee   User?   @relation("AssignedTickets", fields: [assigneeId], references: [id])

  // AI assistance (populated by the pluggable AI provider, see src/lib/ai)
  aiSuggestedCategory String?
  aiSuggestedPriority TicketPriority?
  aiSummary           String?         @db.Text
  /// 0-100 estimate of requester frustration, from AI triage
  sentimentScore      Int?
  aiSuggestedSolution String?         @db.Text

  dueAt        DateTime?
  resolvedAt   DateTime?
  closedAt     DateTime?
  /// True if raised while the tenant's configured out-of-hours window was active
  isOutOfHours Boolean   @default(false)
  /// Soft-deleted tickets are hidden from normal views but recoverable from the trash bin
  isDeleted    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  comments    TicketComment[]
  attachments TicketAttachment[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([tenantId, assigneeId])
}

model TicketComment {
  id         String   @id @default(cuid())
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation(fields: [authorId], references: [id])
  body       String   @db.Text
  /// Internal notes are only visible to AGENT/TENANT_ADMIN/SUPER_ADMIN, never the requester
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())

  attachments TicketAttachment[]
}

model TicketAttachment {
  id          String         @id @default(cuid())
  ticketId    String
  ticket      Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  commentId   String?
  comment     TicketComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  fileName    String
  url         String
  fileSize    Int?
  contentType String?
  createdAt   DateTime       @default(now())
}

// ---------------------------------------------------------------------------
// Knowledge base
// ---------------------------------------------------------------------------

model KbCategory {
  id       String      @id @default(cuid())
  tenantId String
  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name     String
  slug     String
  articles KbArticle[]

  @@unique([tenantId, slug])
}

enum KbStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model KbArticle {
  id         String      @id @default(cuid())
  tenantId   String
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoryId String?
  category   KbCategory? @relation(fields: [categoryId], references: [id])
  title      String
  slug       String
  /// Markdown content
  content    String      @db.Text
  status     KbStatus    @default(DRAFT)
  aiSummary  String?     @db.Text
  viewCount  Int         @default(0)
  /// Soft-deleted articles are hidden from normal views but recoverable from the trash bin
  isDeleted  Boolean     @default(false)

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId, status])
}

// ---------------------------------------------------------------------------
// DfE "Digital and technology standards" compliance checklist
//
// ComplianceStandard/ComplianceItem form a global catalogue (shared across
// all tenants, seeded from prisma/seed.ts). ComplianceAssessment is the
// per-tenant record of where a school stands against each item.
// ---------------------------------------------------------------------------

model ComplianceStandard {
  id          String  @id @default(cuid())
  /// Stable slug matching the DfE standard, e.g. "cyber-security"
  code        String  @unique
  title       String
  description String  @db.Text
  officialUrl String?
  order       Int     @default(0)

  items ComplianceItem[]
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

model ComplianceItem {
  id          String             @id @default(cuid())
  standardId  String
  standard    ComplianceStandard @relation(fields: [standardId], references: [id], onDelete: Cascade)
  code        String
  title       String
  description String             @db.Text
  guidance    String?            @db.Text
  order       Int                @default(0)
  /// How much this item matters relative to others under the same standard
  priority    Priority           @default(MEDIUM)
  /// Deep link to the specific DfE guidance sub-page for this item, if more specific than the standard's officialUrl
  govLink     String?

  assessments ComplianceAssessment[]

  @@unique([standardId, code])
}

enum ComplianceStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLIANT
  NON_COMPLIANT
  NOT_APPLICABLE
}

model ComplianceAssessment {
  id       String         @id @default(cuid())
  tenantId String
  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  itemId   String
  item     ComplianceItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  status        ComplianceStatus @default(NOT_STARTED)
  evidenceNotes String?          @db.Text
  evidenceUrl   String?

  reviewedById  String?
  reviewedBy    User?     @relation(fields: [reviewedById], references: [id])
  reviewedAt    DateTime?
  nextReviewDue DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, itemId])
  @@index([tenantId, status])
}

// ---------------------------------------------------------------------------
// AI provider configuration (pluggable: Claude or Gemini, per tenant)
// ---------------------------------------------------------------------------

enum AiProvider {
  CLAUDE
  GEMINI
  DISABLED
}

model AiProviderConfig {
  id                   String     @id @default(cuid())
  tenantId             String     @unique
  tenant               Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider             AiProvider @default(DISABLED)
  model                String?
  /// Encrypted at rest by src/lib/crypto.ts before being written here
  apiKeyCiphertext     String?
  ticketTriageEnabled  Boolean    @default(true)
  kbSuggestionsEnabled Boolean    @default(true)
  updatedAt            DateTime   @updatedAt
}

// ---------------------------------------------------------------------------
// Audit log — records privileged actions for DfE cyber security / data
// protection accountability requirements.
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String?
  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
}

// ---------------------------------------------------------------------------
// Self-service portal customization (branding + content, per tenant)
// ---------------------------------------------------------------------------

model PortalSettings {
  id       String @id @default(cuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  heroTitle      String  @default("Hello, how can we help?")
  heroSubtitle   String  @default("Search our knowledge base or submit a ticket.")
  heroShowSearch Boolean @default(true)

  showAnnouncements   Boolean @default(true)
  showQuickActions    Boolean @default(true)
  showPopularArticles Boolean @default(true)
  showUrgentHelp      Boolean @default(true)
  showUsefulLinks     Boolean @default(true)

  /// { id, title, url }[]
  usefulLinks Json @default("[]")

  urgentHelpEnabled      Boolean @default(true)
  urgentHelpTitle        String  @default("Need urgent help?")
  urgentHelpDescription  String  @default("For critical issues stopping teaching right now, please call us immediately.") @db.Text
  urgentHelpHotline      String  @default("")
  urgentHelpEmail        String  @default("")
  urgentHelpAvailability String  @default("Available during school office hours")

  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Finance / procurement tracking
// ---------------------------------------------------------------------------

enum FinanceStatus {
  PENDING
  APPROVED
  ORDERED
  DELIVERED
}

model FinanceRecord {
  id          String @id @default(cuid())
  tenantId    String
  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  poNumber    String
  description String @db.Text
  /// Stored in pence to avoid floating-point rounding on currency
  amountPence Int
  vendor      String

  status FinanceStatus @default(PENDING)

  requestedById String
  requestedBy   User   @relation(fields: [requestedById], references: [id])

  requestDate DateTime @default(now())
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, status])
}

// ---------------------------------------------------------------------------
// Forums
// ---------------------------------------------------------------------------

enum ForumVisibility {
  PUBLIC // visible to requesters too
  INTERNAL // staff only
}

model ForumCategory {
  id          String          @id @default(cuid())
  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title       String
  description String?
  visibility  ForumVisibility @default(PUBLIC)
  order       Int             @default(0)

  topics ForumTopic[]

  @@unique([tenantId, title])
}

model ForumTopic {
  id         String        @id @default(cuid())
  tenantId   String
  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoryId String
  category   ForumCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  title      String
  content    String        @db.Text

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  pinned    Boolean  @default(false)
  views     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  replies ForumReply[]

  @@index([tenantId, categoryId])
}

model ForumReply {
  id      String     @id @default(cuid())
  topicId String
  topic   ForumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  content   String   @db.Text
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Assets inventory (manual register — no live device telemetry)
// ---------------------------------------------------------------------------

enum AssetStatus {
  ACTIVE
  IN_REPAIR
  RETIRED
  LOST
}

model Asset {
  id           String  @id @default(cuid())
  tenantId     String
  tenant       Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tag          String
  name         String
  model        String?
  serialNumber String?

  assignedToId String?
  assignedTo   User?   @relation(fields: [assignedToId], references: [id])

  status         AssetStatus @default(ACTIVE)
  purchaseDate   DateTime?
  warrantyExpiry DateTime?
  isDeleted      Boolean     @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, tag])
}

// ---------------------------------------------------------------------------
// Announcements
// ---------------------------------------------------------------------------

enum AnnouncementType {
  INFO
  WARNING
  ALERT
}

enum AnnouncementAudience {
  ALL
  STAFF
  REQUESTERS
}

model Announcement {
  id             String               @id @default(cuid())
  tenantId       String
  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title          String
  message        String               @db.Text
  type           AnnouncementType     @default(INFO)
  targetAudience AnnouncementAudience @default(ALL)
  active         Boolean              @default(true)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([tenantId, active])
}

// ---------------------------------------------------------------------------
// Canned responses
// ---------------------------------------------------------------------------

model CannedResponse {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title    String
  shortcut String
  content  String @db.Text

  createdAt DateTime @default(now())

  @@unique([tenantId, shortcut])
}

// ---------------------------------------------------------------------------
// Agent tools — IT quick-reference commands and admin console links.
// Sensible defaults ship as app-level constants (src/lib/agent-tools.ts);
// these models are only for a tenant's own additions.
// ---------------------------------------------------------------------------

enum AgentOs {
  WINDOWS
  MAC
  CHROMEBOOK
}

model AgentToolCommand {
  id          String  @id @default(cuid())
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title       String
  command     String
  description String?
  os          AgentOs

  createdAt DateTime @default(now())
}

model AgentToolLink {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title    String
  url      String

  createdAt DateTime @default(now())
}
