# Copy this file to .env.local (for `next dev`) and .env (for `prisma` CLI commands).
# Never commit real secrets — .env* files are gitignored.

# --- Database -----------------------------------------------------------
# Local dev: `docker run --name novadesk-db -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=novadesk -p 5432:5432 -d postgres:16`
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/novadesk"

# --- Auth.js (NextAuth) ---------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# --- Google Identity Platform / Google Workspace SSO ---------------------
# Create OAuth 2.0 credentials in the GCP Console (APIs & Services > Credentials)
# for a project with Google Identity Platform enabled. Authorised redirect URI:
# http://localhost:3000/api/auth/callback/google (add your production URL too).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- 2FA -------------------------------------------------------------------
# Used to encrypt TOTP secrets and AI provider API keys at rest (AES-256-GCM).
# Generate with: openssl rand -hex 32
APP_ENCRYPTION_KEY=""

# --- AI providers (pluggable — configure one or both) ---------------------
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5"

GOOGLE_GENAI_API_KEY=""
GOOGLE_GENAI_MODEL="gemini-2.5-flash"

# Default provider (CLAUDE | GEMINI | DISABLED)
DEFAULT_AI_PROVIDER="DISABLED"

# --- File storage ------------------------------------------------------------
# Local-disk storage for ticket attachments (see src/lib/storage.ts). Fine for
# dev/single-instance use; swap for Cloud Storage before deploying to Cloud Run
# with more than one instance (attachments wouldn't survive a redeploy either).
UPLOAD_STORAGE_DIR="./storage/uploads"

# --- Email notifications ------------------------------------------------------
# SMTP relay for outbound notifications. Leave SMTP_HOST unset and
# notifications just log to the console in dev, or are silently disabled in
# production.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Novadesk Helpdesk <no-reply@novadesk.app>"
